{
	"name": "cosmic-workout",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev --open --port 5678 --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --write . && eslint . --fix",
		"test": "node --test \"src/**/*.test.ts\"",
		"docs:links": "node scripts/check-doc-links.mjs",
		"format": "prettier --write .",
		"icons": "node scripts/build-icons.ts"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "26.6.6",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.0",
		"vite": "8.3.0"
	},
	"dependencies": {
		"@fontsource/jetbrains-mono": "5.3.0",
		"@fontsource/unbounded": "5.3.0",
		"@tanstack/charts": "1.5.0",
		"jsqr": "1.4.0",
		"uqr": "0.1.3"
	}
}
